rules_version = '2';

// Rules cho app "Vườn Học Tập" — mô hình NHIỀU Phụ huynh có thể cùng quản lý
// MỘT tài khoản Học sinh (con), tất cả phụ huynh liên kết có quyền ngang nhau
// (tạo/sửa/xoá bài tập, chấm điểm) trên các con mà họ được liên kết.
//
// Liên kết thêm phụ huynh dùng cơ chế "mã mời": phụ huynh đang quản lý một
// bé tạo ra 1 mã mời (collection `invites`), chia sẻ mã đó (vd: qua Zalo/tin
// nhắn) cho phụ huynh khác; phụ huynh kia nhập mã để tự liên kết mình vào
// hồ sơ của bé. Đây là bộ rules khởi điểm hợp lý cho dùng trong một gia đình
// / nhóm nhỏ (gia đình mở rộng). Nếu triển khai cho nhiều gia đình không quen
// biết nhau cùng lúc, nên kiểm thử kỹ trong Firebase Console → Firestore →
// Rules Playground trước khi dùng thật.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function myUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // true nếu người dùng hiện tại là MỘT TRONG CÁC phụ huynh của childId.
    // Dựa trên field "children" nằm trên chính hồ sơ phụ huynh — luôn đúng
    // cho mọi phụ huynh đã liên kết (dù họ là người tạo bé hay tham gia sau
    // bằng mã mời), nên tất cả phụ huynh liên kết có quyền ngang nhau.
    function isParentOf(childId) {
      return isSignedIn() &&
        myUser().role == 'parent' &&
        childId in myUser().children;
    }

    // users/{uid}: hồ sơ của chính mình, hoặc phụ huynh xem hồ sơ con mình
    match /users/{userId} {
      allow read: if isSignedIn() && (
        request.auth.uid == userId || isParentOf(userId)
      );

      // Tạo hồ sơ:
      // - Tự tạo hồ sơ của chính uid mình (khi phụ huynh tự đăng ký), HOẶC
      // - Một phụ huynh đã đăng nhập tạo hồ sơ role="student" cho con mình
      //   (tài khoản con được tạo qua secondary app, nhưng hồ sơ Firestore
      //   được ghi trong khi phiên đăng nhập chính vẫn là phụ huynh).
      //   parentIds khi tạo mới chỉ được chứa đúng 1 phụ huynh: người tạo.
      allow create: if isSignedIn() && (
        request.auth.uid == userId ||
        (
          myUser().role == 'parent' &&
          request.resource.data.role == 'student' &&
          request.resource.data.parentIds is list &&
          request.resource.data.parentIds == [request.auth.uid]
        )
      );

      // Cập nhật:
      // - Chủ tài khoản tự sửa hồ sơ của chính mình (không giới hạn field —
      //   giữ như thiết kế gốc để phụ huynh có thể cập nhật "children" khi
      //   thêm con, hoặc tự sửa tên...).
      // - HOẶC một phụ huynh KHÁC tự liên kết mình làm đồng phụ huynh của
      //   một học sinh, bằng cách xuất trình một mã mời hợp lệ (đã được
      //   chính một phụ huynh hiện tại của bé đó tạo ra). Update này CHỈ
      //   được phép thêm chính uid của người gọi vào mảng parentIds (không
      //   được đổi field nào khác ngoài parentIds + lastJoinCode).
      allow update: if isSignedIn() && (
        request.auth.uid == userId ||
        (
          resource.data.role == 'student' &&
          myUser().role == 'parent' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['parentIds', 'lastJoinCode']) &&
          resource.data.parentIds is list &&
          request.resource.data.parentIds == resource.data.parentIds.concat([request.auth.uid]) &&
          request.resource.data.lastJoinCode is string &&
          get(/databases/$(database)/documents/invites/$(request.resource.data.lastJoinCode)).data.studentId == userId
        )
      );
      allow delete: if false;
    }

    // invites/{code}: mã mời để thêm đồng phụ huynh cho 1 học sinh.
    // Document ID chính là mã mời (chuỗi ngẫu nhiên) — không thể liệt kê
    // (list) toàn bộ collection, chỉ đọc được khi biết đúng mã.
    match /invites/{code} {
      allow get: if isSignedIn();
      allow list: if false;
      // Chỉ một phụ huynh ĐANG quản lý bé đó mới được tạo mã mời cho bé đó.
      allow create: if isSignedIn() &&
        myUser().role == 'parent' &&
        isParentOf(request.resource.data.studentId) &&
        request.resource.data.createdBy == request.auth.uid;
      allow update: if false;
      // Người tạo mã có thể thu hồi (xoá) mã mời của chính mình.
      allow delete: if isSignedIn() && resource.data.createdBy == request.auth.uid;
    }

    // subjects/{id} — môn học do phụ huynh tự tạo cho từng bé (thay cho danh
    // sách môn học cố định). Chỉ phụ huynh liên kết với bé đó mới được
    // tạo/sửa/xoá; học sinh (và phụ huynh) chỉ được đọc.
    match /subjects/{subjectId} {
      allow read: if isSignedIn() && (
        resource.data.studentId == request.auth.uid ||
        isParentOf(resource.data.studentId)
      );
      allow create: if isSignedIn() &&
        myUser().role == 'parent' &&
        request.resource.data.createdBy == request.auth.uid &&
        isParentOf(request.resource.data.studentId);
      // Bất kỳ phụ huynh nào liên kết với học sinh đó đều được sửa/xoá môn học.
      allow update, delete: if isSignedIn() && isParentOf(resource.data.studentId);
    }

    // assignments/{id}
    match /assignments/{assignmentId} {
      allow read: if isSignedIn() && (
        resource.data.studentId == request.auth.uid ||
        isParentOf(resource.data.studentId)
      );
      allow create: if isSignedIn() &&
        myUser().role == 'parent' &&
        request.resource.data.createdBy == request.auth.uid &&
        isParentOf(request.resource.data.studentId);
      // Bất kỳ phụ huynh nào liên kết với học sinh đó đều được sửa/xoá bài
      // tập (không chỉ riêng người đã tạo ra bài tập).
      allow update, delete: if isSignedIn() && isParentOf(resource.data.studentId);
    }

    // submissions/{assignmentId} — doc id trùng với assignment id
    match /submissions/{assignmentId} {
      allow read: if isSignedIn() && (
        resource.data.studentId == request.auth.uid ||
        isParentOf(resource.data.studentId)
      );
      // Học sinh tạo bài nộp cho chính mình (lần nộp đầu tiên)
      allow create: if isSignedIn() &&
        request.resource.data.studentId == request.auth.uid &&
        get(/databases/$(database)/documents/assignments/$(assignmentId)).data.studentId == request.auth.uid;
      allow update: if isSignedIn() && (
        // Bất kỳ phụ huynh nào liên kết với học sinh đó đều được chấm điểm /
        // yêu cầu làm lại / sửa / xoá.
        isParentOf(resource.data.studentId)
        ||
        (
          // Học sinh tự NỘP LẠI bài của chính mình. Bắt buộc điểm/nhận xét/
          // trạng thái "cần làm lại" phải được đưa về rỗng — học sinh không
          // được tự gán điểm cho mình hay tự xoá cờ "cần làm lại" một cách
          // gian lận; việc reset các field này chỉ có ý nghĩa khi đi kèm với
          // hành động nộp bài mới thật sự (ứng dụng luôn đặt các giá trị này
          // về null/false mỗi lần học sinh nộp lại).
          resource.data.studentId == request.auth.uid &&
          request.resource.data.studentId == request.auth.uid &&
          request.resource.data.assignmentId == resource.data.assignmentId &&
          request.resource.data.grade == null &&
          request.resource.data.feedback == null &&
          request.resource.data.gradedAt == null &&
          request.resource.data.needsRedo == false &&
          request.resource.data.redoNote == null &&
          request.resource.data.redoRequestedAt == null
        )
      );
      allow delete: if isSignedIn() && isParentOf(resource.data.studentId);
    }
  }
}
